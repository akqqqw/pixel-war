{
  "name": "pixel-war",
  "private": true,
  "version": "0.1.0",
  "description": "Мировое господство: Pixel War — 2D пиксельная военная стратегия",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
